@page
@model EduKita.Web.Pages.Instructor.Lessons.CreateModel
@{
    ViewData["Title"] = "Tambah Pelajaran";
}

<div class="page-head">
    <div class="small text-muted mb-1">
        <a asp-page="/Instructor/Courses/Manage" asp-route-id="@Model.Course.Id" class="d-inline-flex align-items-center gap-1"><partial name="/Pages/Shared/_Icon.cshtml" model='"arrow-left"' />Kembali ke Kelola Kursus</a>
    </div>
    <h1>Tambah Pelajaran</h1>
    <p class="text-muted mb-0">Kursus: @Model.Course.Title — Modul: @Model.Module.Title</p>
</div>

<div class="content-card">
    <form method="post" asp-route-moduleId="@Model.Module.Id">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
        <partial name="LessonFormSnippet" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary fw-semibold px-4">Simpan Pelajaran</button>
            <a asp-page="/Instructor/Courses/Manage" asp-route-id="@Model.Course.Id" class="btn btn-outline-secondary">Batal</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
