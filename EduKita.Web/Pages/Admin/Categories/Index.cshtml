@page
@model EduKita.Web.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Kelola Kategori";
}

<div class="page-head">
    <div class="small text-muted mb-1"><a asp-page="/Admin/Index">Kembali ke Panel Admin</a></div>
    <h1>Kelola Kategori</h1>
    <p class="text-muted mb-0">Kategori membantu siswa menemukan kursus yang tepat</p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="content-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Kategori</th>
                            <th class="text-center">Jumlah Kursus</th>
                            <th class="text-end pe-4">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="stat-icon" style="width:32px;height:32px;min-width:32px;border-radius:8px"><partial name="/Pages/Shared/_Icon.cshtml" model="cat.Icon" /></span>
                                        <span>
                                            <strong>@cat.Name</strong>
                                            @if (!string.IsNullOrEmpty(cat.Description))
                                            {
                                                <div class="small text-muted">@cat.Description</div>
                                            }
                                        </span>
                                    </span>
                                </td>
                                <td class="text-center">@cat.Courses.Count</td>
                                <td class="text-end pe-4">
                                    <a asp-page="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" class="d-inline"
                                          onsubmit="return confirm('Hapus kategori ini?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="content-card">
            <h2 class="h6 fw-bold mb-3">Tambah Kategori Baru</h2>
            <form method="post" asp-page-handler="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.Name" class="form-label">Nama</label>
                    <input asp-for="Input.Name" class="form-control" placeholder="cth: Mobile Development" />
                    <span asp-validation-for="Input.Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Icon" class="form-label">Kata kunci ikon</label>
                    <input asp-for="Input.Icon" class="form-control" placeholder="book" maxlength="16" list="icon-keywords" />
                    <datalist id="icon-keywords">
                        <option value="code">Pemrograman</option>
                        <option value="globe">Web / dunia</option>
                        <option value="data">Data &amp; analitik</option>
                        <option value="brush">Desain</option>
                        <option value="briefcase">Bisnis</option>
                        <option value="book-open">Umum</option>
                    </datalist>
                    <div class="form-text">Kosongkan untuk ikon buku default.</div>
                    <span asp-validation-for="Input.Icon" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label">Deskripsi</label>
                    <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary fw-semibold px-4">Tambah Kategori</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
